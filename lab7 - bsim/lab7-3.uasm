| LAB #7
| AMP
| - Chua, Phoebe
| - Mabini, Ammon
| - Verzosa, Matthew

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm          

| For our in place sort (ascending), we used the "insertion" sort algorithm 
| because it needs only a few registers and no extra memory, so it never writes
| outside the original block. 

        LD(r31, ARRAY, r1)      | R1 = n
        CMOVE(ARRAY+8, r2)      | R2 = A[1] 
        SHLC(r1, 2, r3)         | 
        ADDC(r3, ARRAY+4, r3)   | R3 = A[n]

OUTER:  CMPLT(r2, r3, r5)       | while r5 = (i < n)
        BF(r5, DONE)
        LD(r2, 0, r9)           | key = A[i]
        MOVE(r2, r7)            | empty = i

INNER:  CMPLEC(r7, ARRAY+4, r5) | while (empty > 0)
        BT(r5, PLACE)
        LD(r7, -4, r8)          | R8 = A[empty-1]
        CMPLT(r9, r8, r5)       | and key < A[empty-1]
        BF(r5, PLACE)
        ST(r8, 0, r7)           | A[empty] = A[empty-1]  (shift right)
        SUBC(r7, 4, r7)         | empty--
        BR(INNER)

PLACE:  ST(r9, 0, r7)           | A[empty] = key
        ADDC(r2, 4, r2)         | i++
        BR(OUTER)

DONE:   HALT()

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

. = 0x100

ARRAY:
        LONG(7)             | <-- length of the array
        LONG(23)             | <-- first element of the array
        LONG(1)
        LONG(10)
        LONG(5)
        LONG(2)
        LONG(9)
        LONG(3)            | <-- last element of the array